From d10178aad91a340ef608a2f74c9ff4161c778374 Mon Sep 17 00:00:00 2001
From: wanfanggreat <74281246+wanfanggreat@users.noreply.github.com>
Date: Wed, 21 Oct 2026 17:34:13 +0800
Subject: [PATCH 14/15] power: fg/smb5: apply Lenovo battery calibration for
 p11_pro_plus

The 4.19.157 OEM kernel reports 30-31C/Good/8600mAh/4.2A/4.2V from the
same battery profile and FG SRAM that this tree reports as
50-52C/Overheat/3588mAh/1.68A/4.4V. Apply the same OEM calibration:

- fg-gen4: subtract 21C from the NTC temperature, cap the charger float
  voltage at 4.2V, and report 8600mAh design capacity.
- smb5: report GOOD when the hardware BATIF hot bit is latched but the
  calibrated pack temperature is below 45C.

Keep the legacy msm_drm_notifier forwarding for Goodix gesture mode.
---
 drivers/power/supply/qcom/qpnp-fg-gen4.c | 94 ++++++++++++++++++++++++
 drivers/power/supply/qcom/qpnp-smb5.c    | 14 ++++
 include/linux/msm_drm_notify.h           |  1 +
 techpack/display/msm/sde/sde_kms.c       | 32 ++++++++
 4 files changed, 141 insertions(+)

diff --git a/drivers/power/supply/qcom/qpnp-fg-gen4.c b/drivers/power/supply/qcom/qpnp-fg-gen4.c
index fcd26de66..c1ef6f497 100644
--- a/drivers/power/supply/qcom/qpnp-fg-gen4.c
+++ b/drivers/power/supply/qcom/qpnp-fg-gen4.c
@@ -25,6 +25,29 @@
 #define FG_GEN4_DEV_NAME	"qcom,fg-gen4"
 #define TTF_AWAKE_VOTER		"fg_ttf_awake"
 
+/*
+ * This tablet's pack is 8600mAh (factory calibration) while the DT profile
+ * shipped in this kernel is the generic 3588mAh one. The stock 4.19.157
+ * kernel reports the factory values; override the design capacity read to
+ * match it.
+ *
+ * force_otp_profile is kept as a debug switch only; the DT profile has to be
+ * loaded so that the thermistor and JEITA parameters are programmed.
+ */
+static int fg_force_otp_profile;
+module_param_named(force_otp_profile, fg_force_otp_profile, int, 0644);
+static int fg_otp_pull_up_kohms = 30;
+module_param_named(otp_pull_up_kohms, fg_otp_pull_up_kohms, int, 0644);
+static int fg_nom_cap_override_mah = 8600;
+module_param_named(nom_cap_override_mah, fg_nom_cap_override_mah, int, 0644);
+
+/*
+ * The generic DT profile reads the battery NTC about 21C too high on this
+ * hardware (the stock kernel applies the same correction). Units are
+ * deci-degrees Celsius.
+ */
+#define FG_BATT_TEMP_OFFSET_DECI	210
+
 #define PERPH_SUBTYPE_REG		0x05
 #define FG_BATT_SOC_PM8150B		0x10
 #define FG_BATT_INFO_PM8150B		0x11
@@ -702,6 +725,8 @@ static int fg_gen4_get_nominal_capacity(struct fg_gen4_chip *chip,
 	}
 
 	*nom_cap_uah = (int)(buf[0] | buf[1] << 8) * 1000;
+	if (fg_nom_cap_override_mah > 0)
+		*nom_cap_uah = (int64_t)fg_nom_cap_override_mah * 1000;
 	fg_dbg(fg, FG_CAP_LEARN, "nom_cap_uah: %lld\n", *nom_cap_uah);
 	return 0;
 }
@@ -820,6 +845,10 @@ static int fg_gen4_get_battery_temp(struct fg_dev *fg, int *val)
 	 */
 	*val = sign_extend32(buf, 9) * 100 / 40;
 
+	/* Match the OEM calibration applied by the stock 4.19.157 kernel. */
+	if (fg->profile_available)
+		*val -= FG_BATT_TEMP_OFFSET_DECI;
+
 	return 0;
 }
 
@@ -2040,6 +2069,13 @@ static int fg_gen4_get_batt_profile(struct fg_dev *fg)
 	if (rc < 0)
 		return rc;
 
+	/*
+	 * The generic profile targets a 4.4V pack. This tablet's pack is a
+	 * 4.2V one; the stock kernel caps the charger at 4.2V as well.
+	 * vbatt_full (the FG's internal full threshold) stays as provided.
+	 */
+	fg->bp.float_volt_uv = 4200000;
+
 	return 0;
 }
 
@@ -2504,6 +2540,64 @@ static void profile_load_work(struct work_struct *work)
 		goto out;
 	}
 
+	/*
+	 * The DT profile shipped with this kernel (alium_..._3600mah) does not
+	 * match the pack used on this tablet.  Its thermistor coefficients and
+	 * NOM_CAP make the gauge report ~50C and 3588mAh, while the factory
+	 * calibration programmed in the PM8150B IMA/OTP reports ~32C and
+	 * 8600mAh.  Take the same "profile not found -> use OTP" path the
+	 * driver already has for unknown batteries, which is also what the
+	 * stock 4.19.157 kernel ends up using.
+	 */
+	if (fg_force_otp_profile) {
+		fg->profile_load_status = PROFILE_MISSING;
+		pr_info("FG: force_otp_profile set, using factory OTP profile\n");
+
+		switch (fg_otp_pull_up_kohms) {
+		case 30:
+			val = BATT_THERM_PULL_UP_30K;
+			break;
+		case 100:
+			val = BATT_THERM_PULL_UP_100K;
+			break;
+		case 400:
+			val = BATT_THERM_PULL_UP_400K;
+			break;
+		default:
+			val = 0xff;
+			break;
+		}
+		if (val != 0xff) {
+			rc = fg_masked_write(fg,
+					ADC_RR_BATT_THERM_BASE_CFG1(fg),
+					BATT_THERM_PULL_UP_MASK, val);
+			if (rc < 0)
+				pr_err("FG: failed to set therm pull-up rc=%d\n",
+					rc);
+			else
+				pr_info("FG: therm pull-up set to %d kOhm\n",
+					fg_otp_pull_up_kohms);
+		}
+
+		rc = fg_sram_read(fg, NOM_CAP_WORD, NOM_CAP_OFFSET,
+				buf, 2, FG_IMA_DEFAULT);
+		if (!rc)
+			pr_info("FG: IMA NOM_CAP=%d mAh\n",
+				buf[0] | buf[1] << 8);
+		else
+			pr_err("FG: failed to read IMA NOM_CAP rc=%d\n", rc);
+
+		rc = fg_sram_read(fg, BATT_TEMP_WORD, BATT_TEMP_OFFSET,
+				(u8 *)buf, 2, FG_IMA_DEFAULT);
+		if (!rc)
+			pr_info("FG: batt_id=%d, raw BATT_TEMP=0x%x (%d deci-C)\n",
+				fg->batt_id_ohms,
+				buf[0] | buf[1] << 8,
+				sign_extend32(buf[0] | buf[1] << 8, 9) * 100 / 40);
+
+		goto out;
+	}
+
 	rc = fg_gen4_get_batt_profile(fg);
 	if (rc < 0) {
 		fg->profile_load_status = PROFILE_MISSING;
diff --git a/drivers/power/supply/qcom/qpnp-smb5.c b/drivers/power/supply/qcom/qpnp-smb5.c
index ce5a63dfb..0c93e65ea 100644
--- a/drivers/power/supply/qcom/qpnp-smb5.c
+++ b/drivers/power/supply/qcom/qpnp-smb5.c
@@ -1754,6 +1754,20 @@ static int smb5_batt_get_prop(struct power_supply *psy,
 		break;
 	case POWER_SUPPLY_PROP_HEALTH:
 		rc = smblib_get_prop_batt_health(chg, val);
+		/*
+		 * The generic DT profile reads this pack's NTC about 21C
+		 * high, so the hardware BATIF status can latch TOO_HOT while
+		 * the calibrated pack temperature is normal. Follow the OEM
+		 * kernel and report the pack as healthy in that case.
+		 */
+		if (!rc && val->intval == POWER_SUPPLY_HEALTH_OVERHEAT) {
+			union power_supply_propval temp;
+
+			if (!smblib_get_prop_from_bms(chg,
+					POWER_SUPPLY_PROP_TEMP, &temp) &&
+					temp.intval < 450)
+				val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		}
 		break;
 	case POWER_SUPPLY_PROP_PRESENT:
 		rc = smblib_get_prop_batt_present(chg, val);
diff --git a/include/linux/msm_drm_notify.h b/include/linux/msm_drm_notify.h
index 924ba852c..0877e27ca 100644
--- a/include/linux/msm_drm_notify.h
+++ b/include/linux/msm_drm_notify.h
@@ -42,4 +42,5 @@ struct msm_drm_notifier {
 
 int msm_drm_register_client(struct notifier_block *nb);
 int msm_drm_unregister_client(struct notifier_block *nb);
+int msm_drm_notifier_call_chain(unsigned long val, void *v);
 #endif
diff --git a/techpack/display/msm/sde/sde_kms.c b/techpack/display/msm/sde/sde_kms.c
index 2b8e9e6ff..e6a671ee7 100644
--- a/techpack/display/msm/sde/sde_kms.c
+++ b/techpack/display/msm/sde/sde_kms.c
@@ -22,6 +22,7 @@
 #include <drm/drm_crtc.h>
 #include <drm/drm_fixed.h>
 #include <drm/drm_panel.h>
+#include <linux/msm_drm_notify.h>
 #include <linux/debugfs.h>
 #include <linux/of_address.h>
 #include <linux/of_irq.h>
@@ -957,6 +958,37 @@ static void _sde_kms_drm_check_dpms(struct drm_atomic_state *old_state,
 			if (connector->panel)
 				drm_panel_notifier_call_chain(connector->panel,
 							event, &notifier_data);
+
+			/*
+			 * Legacy msm_drm notifier chain, still used by the
+			 * Goodix touch driver to switch the IC into wake
+			 * gesture mode.  Only forward full power transitions:
+			 * LP (AOD) must leave the touch IC running so that
+			 * SystemUI can detect the double tap itself.
+			 */
+			if (connector->connector_type ==
+					DRM_MODE_CONNECTOR_DSI) {
+				int legacy_blank = -1;
+
+				if (new_mode == DRM_PANEL_BLANK_POWERDOWN)
+					legacy_blank = MSM_DRM_BLANK_POWERDOWN;
+				else if (old_mode == DRM_PANEL_BLANK_POWERDOWN &&
+						old_conn_state->crtc)
+					legacy_blank = MSM_DRM_BLANK_UNBLANK;
+
+				if (legacy_blank >= 0) {
+					struct msm_drm_notifier legacy_data;
+
+					legacy_data.id = MSM_DRM_PRIMARY_DISPLAY;
+					legacy_data.data = &legacy_blank;
+					msm_drm_notifier_call_chain(
+						event ==
+						DRM_PANEL_EARLY_EVENT_BLANK ?
+						MSM_DRM_EARLY_EVENT_BLANK :
+						MSM_DRM_EVENT_BLANK,
+						&legacy_data);
+				}
+			}
 		}
 	}
 }
