+			wm_adsp_k_ctl_get(dsp, "RCV DSP1X Protection cd CAL_R");
+			wm_adsp_k_ctl_get(dsp,
+					  "RCV DSP1X Protection cd CAL_STATUS");
+			wm_adsp_k_ctl_get(
+				dsp, "RCV DSP1X Protection cd CAL_CHECKSUM");
+			//for ultrasonic
+#if defined(CONFIG_MACH_XIAOMI_APOLLO) || defined(CONFIG_MACH_XIAOMI_CAS) ||   \
+	defined(CONFIG_MACH_XIAOMI_ALIOTH) ||                                  \
+	defined(CONFIG_MACH_XIAOMI_PSYCHE)
+			wm_adsp_k_ctl_put(
+				dsp,
+				"RCV DSP1X Protection 400a4 E_FULL_US_BYPASS",
+				1);
+			wm_adsp_k_ctl_get(
+				dsp,
+				"RCV DSP1X Protection 400a4 E_FULL_US_BYPASS");
+#endif
