- config_setColorTransformAccelerated=true（优先 HWC 路径）
- config_nightDisplayAvailable / config_reduceBrightColorsAvailable=true 显式兜底
- 只改 framework overlay，不动源文件
---
 overlay/frameworks/base/core/res/res/values/config.xml | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/overlay/frameworks/base/core/res/res/values/config.xml b/overlay/frameworks/base/core/res/res/values/config.xml
index 0b303af..72d7e66 100644
--- a/overlay/frameworks/base/core/res/res/values/config.xml
+++ b/overlay/frameworks/base/core/res/res/values/config.xml
@@ -7,4 +7,13 @@
     -->
     <integer name="config_defaultRefreshRate">0</integer>
     <integer name="config_defaultPeakRefreshRate">90</integer>
+
+    <!--
+      Phase 1B：Night Light / 降低亮色。
+      先走 HWC 加速路径（原厂面板支持 setColorTransform）；若出现花屏/异常，
+      改成只覆盖 config_nightDisplayAvailable 和 config_reduceBrightColorsAvailable 走 GPU。
+    -->
+    <bool name="config_setColorTransformAccelerated">true</bool>
+    <bool name="config_nightDisplayAvailable">true</bool>
+    <bool name="config_reduceBrightColorsAvailable">true</bool>
 </resources>
