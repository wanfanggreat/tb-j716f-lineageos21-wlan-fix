Date: Sun, 18 Oct 2026 23:07:17 +0800
Subject: [PATCH 13/24] =?UTF-8?q?feat(display):=20Phase=201A=20=E5=88=B7?=
 =?UTF-8?q?=E6=96=B0=E7=8E=87=2060/90=EF=BC=88batch24=EF=BC=89?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- framework overlay: config_defaultRefreshRate=0 + config_defaultPeakRefreshRate=90
  （default=0 时 peak 充当默认帧率，开机默认 90Hz）
- Settings overlay: 打开平滑显示 / 峰值刷新率 / 最低刷新率三个开关
- 仅资源覆盖，不动 frameworks/base 源文件
---
 .../base/core/res/res/values/config.xml          | 16 +++++++++-------
 .../apps/Settings/res/values/lineage_config.xml  |  8 ++++++--
 2 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/overlay/frameworks/base/core/res/res/values/config.xml b/overlay/frameworks/base/core/res/res/values/config.xml
index 5156501..0b303af 100644
--- a/overlay/frameworks/base/core/res/res/values/config.xml
+++ b/overlay/frameworks/base/core/res/res/values/config.xml
@@ -1,8 +1,10 @@
 <?xml version="1.0" encoding="utf-8"?>
-<!--
-  Phase 0：空 overlay。
-  仅用于验证 DEVICE_PACKAGE_OVERLAYS 机制本身不影响启动，不覆盖任何资源。
-  后续 Phase 1A/1B 会在这里加 config_defaultRefreshRate / config_defaultPeakRefreshRate /
-  config_setColorTransformAccelerated 等。
--->
-<resources />
+<resources>
+    <!--
+      Phase 1A：刷新率。
+      config_defaultRefreshRate=0 时由 config_defaultPeakRefreshRate 充当默认帧率，
+      因此默认会跑 90Hz；Smooth display 关闭时 Settings 写 peak=60，回落到 60Hz。
+    -->
+    <integer name="config_defaultRefreshRate">0</integer>
+    <integer name="config_defaultPeakRefreshRate">90</integer>
+</resources>
diff --git a/overlay/packages/apps/Settings/res/values/lineage_config.xml b/overlay/packages/apps/Settings/res/values/lineage_config.xml
index 6c11543..a7e1428 100644
--- a/overlay/packages/apps/Settings/res/values/lineage_config.xml
+++ b/overlay/packages/apps/Settings/res/values/lineage_config.xml
@@ -1,3 +1,7 @@
 <?xml version="1.0" encoding="utf-8"?>
-<!-- Phase 0：空 overlay。后续放 config_show_smooth_display 等 Settings 开关。 -->
-<resources />
+<resources>
+    <!-- Phase 1A：在设置 → 显示里放出平滑显示 / 峰值刷新率 / 最低刷新率 -->
+    <bool name="config_show_smooth_display">true</bool>
+    <bool name="config_show_peak_refresh_rate_switch">true</bool>
+    <bool name="config_show_min_refresh_rate_switch">true</bool>
+</resources>
