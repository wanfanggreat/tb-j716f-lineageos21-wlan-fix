AOSP 默认 time.android.com 在国内容易 UDP 123 超时，导致自动时间一直失败。Settings.Global.NTP_SERVER 仍优先于此配置。
---
 overlay/frameworks/base/core/res/res/values/config.xml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/overlay/frameworks/base/core/res/res/values/config.xml b/overlay/frameworks/base/core/res/res/values/config.xml
index 49a445e..3cd5dbf 100644
--- a/overlay/frameworks/base/core/res/res/values/config.xml
+++ b/overlay/frameworks/base/core/res/res/values/config.xml
@@ -17,6 +17,16 @@
         <item>0:2:15</item>
     </string-array>
 
+    <!--
+      时间同步：AOSP 默认的 time.android.com 在国内容易被阻断（UDP 123 超时），
+      导致自动时间一直失败、重启后回落到构建时间。改用国内可达的 NTP。
+      Settings.Global.NTP_SERVER 优先级更高，可用 settings put 覆盖这里。
+    -->
+    <string-array name="config_ntpServers" translatable="false">
+        <item>ntp://ntp.aliyun.com</item>
+        <item>ntp://cn.pool.ntp.org</item>
+    </string-array>
+
